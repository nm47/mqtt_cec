# MQTT Broker Configuration (REQUIRED)
MQTT_BROKER_HOST=192.168.1.100
MQTT_BROKER_PORT=1883

# MQTT Authentication (Optional)
MQTT_USERNAME=
MQTT_PASSWORD=

# MQTT Device Configuration (Tasmota-compatible pattern)
# Device name used to build topic hierarchy: cmnd/{device}/POWER, tele/{device}/STATE, etc.
MQTT_DEVICE_NAME=tv
MQTT_CLIENT_ID=mqtt_cec_controller
MQTT_QOS=1

# MQTT Telemetry Configuration
# How often to publish state updates (in seconds)
MQTT_STATE_INTERVAL=300

# MQTT Availability Messages (Optional)
MQTT_AVAILABILITY_ONLINE=Online
MQTT_AVAILABILITY_OFFLINE=Offline

# HDMI-CEC Configuration
CEC_ADAPTER=/dev/cec0
# Name the TV shows for this device's input (max 14 characters)
CEC_OSD_NAME=Raspberry Pi
# Seconds between TV power status polls (0 = only at startup and on TV wake)
CEC_POLL_INTERVAL=30
# Turn TV remote buttons into keystrokes on the Pi while it is the active input
CEC_REMOTE_KEYS=true

# Logging
LOG_LEVEL=INFO

# DEPRECATED - Use MQTT_DEVICE_NAME instead
# MQTT_TOPIC=tv/power
# DEPRECATED - was actually cec-client's log level; use CEC_ADAPTER
# CEC_DEVICE=1
